# 复制为 .env 后填写；.env 已被 .gitignore 忽略，切勿提交到仓库
# docker compose 会自动读取项目根目录的 .env

# ---- 基础部署 ----
MYSQL_ROOT_PASSWORD=change-me
PUBLIC_GATEWAY_URL=http://localhost:10010
PUBLIC_FRONTEND_URL=http://localhost:8080
GATEWAY_PORT=10010
FRONTEND_PORT=8080
NACOS_CONSOLE_PORT=8849

# ---- 应用内部密钥（生产环境请改成随机长字符串，网关与 mall-mgr 必须一致） ----
MALL_TOKEN_SECRET=
MALL_INTERNAL_TOKEN=

# ---- 支付宝开放平台（手机网站支付） ----
# 三项凭证齐全才会启用真实支付，否则自动回退本地模拟收银台
# 沙箱网关：https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 生产网关：https://openapi.alipay.com/gateway.do
MALL_ALIPAY_APP_ID=
# 应用私钥（RSA2/PKCS8，单行 base64 或 PEM 均可，不要提交到仓库）
MALL_ALIPAY_PRIVATE_KEY=
# 支付宝公钥（注意不是应用公钥）
MALL_ALIPAY_PUBLIC_KEY=
MALL_ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 支付宝服务器可访问的公网地址；本地无公网时留空，前端会通过查单兜底确认支付
MALL_ALIPAY_NOTIFY_URL=
MALL_ALIPAY_RETURN_URL=
MALL_ALIPAY_SIGN_TYPE=RSA2
